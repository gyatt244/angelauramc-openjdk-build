name: Custom Java 25 Build
on:
  workflow_dispatch:

jobs:
  build:
    name: Build JRE
    runs-on: macos-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Run Build Script
        run: |
          export SLIMMED=0
          gmake -j$(sysctl -n hw.ncpu) package PLATFORM=2
